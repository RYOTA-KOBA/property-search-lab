# LocalStack (2026-03 の Community/Pro イメージ統合以降、無料アカウントの auth token が必須)
# https://app.localstack.cloud/ で無料登録して取得する
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-1

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=property_dev
MYSQL_USER=app
MYSQL_PASSWORD=apppass

# OpenSearch (Task 3 の create-domain.sh 実行後に払い出されたエンドポイントで上書きする)
OS_ENDPOINT=
